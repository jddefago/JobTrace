# Every install's own data is instance-specific — never ship or track it.
data/*
!data/.gitkeep
backups/*
!backups/.gitkeep

# AI-assistant session/config folders some users will end up with locally.
.claude/
.codex/

__pycache__/
*.pyc

# Project virtualenv for the keys-based Gmail sync (GMAIL_SYNC_SETUP.md).
.venv/
venv/

# macOS / editor noise.
.DS_Store

# Local desktop shortcut — hardcodes an absolute path on this machine.
JobTrace.lnk

# Locally generated by setup.command / setup.bat (path baked in per machine).
JobTrace.app/
