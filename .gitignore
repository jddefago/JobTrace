# Every install's own data is instance-specific — never ship or track it.
data/*
!data/.gitkeep
backups/*
!backups/.gitkeep

# AI-assistant session/config folders some users will end up with locally.
.claude/
.codex/

__pycache__/
*.pyc

# Project virtualenv for the keys-based Gmail sync (GMAIL_SYNC_SETUP.md).
.venv/
venv/

# macOS / editor noise.
.DS_Store

# Local one-off / scratch scripts and their output at the repo root
# (never part of the app). Anchored with a leading "/" so real modules like
# backend/sync/_gmail_text.py are unaffected.
/_*.py
/_*.txt
/_*.log
/_*.json

# Local desktop shortcut — hardcodes an absolute path on this machine.
JobTrace.lnk

# Locally generated by setup.command / setup.bat (path baked in per machine).
JobTrace.app/

# Only the compiled SYSTEM_BRIEF.pdf ships. Keep the HTML source locally to
# regenerate it (the command is in the file's header comment); don't track it.
/SYSTEM_BRIEF.source.html
